# Cấu hình Server & Domain
PORT=3000
APP_URL=http://localhost:3000

# Cấu hình MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=quiz_db

# Tài khoản Admin Quản trị
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Khóa bí mật cho JWT Auth Token
JWT_SECRET=super_secret_quiz_jwt_key_2026_onepiece

# Cấu hình Gửi Email qua Gmail SMTP (Xác thực tài khoản & Quên mật khẩu)
# Hướng dẫn tạo App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_account@gmail.com
SMTP_PASSWORD=your_16_digit_google_app_password
SMTP_FROM="ONE PIECE QUIZ" <your_gmail_account@gmail.com>

# Cấu hình Google OAuth 2.0 (Đăng nhập Google One-Tap & Sign-In)
# Xem hướng dẫn chi tiết tại: docs/google-oauth-setup.md
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
